---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	// PLACEHOLDER: real club name/description to be filled in
	title = 'AIAA Chapter — University Rocketry & Aerospace [PLACEHOLDER]',
	description = 'PLACEHOLDER: Student chapter of the American Institute of Aeronautics and Astronautics.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script>
			// Scroll-reveal for [data-reveal] elements (styles in global.css).
			// Hidden state is applied here, at runtime, so content is never
			// invisible without JS or when the user prefers reduced motion.
			const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const targets = document.querySelectorAll('[data-reveal]');

			if (!reduceMotion && 'IntersectionObserver' in window && targets.length > 0) {
				const observer = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('reveal-in');
								observer.unobserve(entry.target);
							}
						}
					},
					{ threshold: 0.15, rootMargin: '0px 0px -40px 0px' },
				);

				for (const el of targets) {
					el.classList.add('reveal-init');
					observer.observe(el);
				}
			}
		</script>
	</body>
</html>
