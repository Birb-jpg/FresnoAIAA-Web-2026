---
interface props {
  title?: string;
}
const { title = "AIAA // Fresno" } = Astro.props;
import "../styles/global.css";
---
<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" href="/aiaalogo.png" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- Hide fade-in elements before first paint so refreshes don't flash the final text.
		     Inline (part of the HTML document) so it applies pre-paint, unlike the bundled stylesheet. -->
		<script is:inline>document.documentElement.classList.add('js');</script>
		<style is:inline>html.js [data-fadein]:not(.is-visible){opacity:0}</style>
	</head>
	<body>
		<a
			href="#main"
			class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-full focus:bg-brand-dark focus:px-5 focus:py-2 focus:text-sm focus:text-white"
		>Skip to content</a>
		<slot />
		<script>
			const els = document.querySelectorAll('[data-fadein]');

			els.forEach((el) => {
				const delay = el.getAttribute('data-fadein-delay');
				if (delay) {
				(el as HTMLElement).style.setProperty('--fadein-delay', `${delay}ms`);
				}
			});

			const observer = new IntersectionObserver(
				(entries) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
					entry.target.classList.add('is-visible');
					observer.unobserve(entry.target);
					}
				});
				},
				{ threshold: 0.15 }
			);

			els.forEach((el) => observer.observe(el));
		</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}

	/* a stray wide child should never hand a phone a sideways scrollbar */
	body {
		overflow-x: clip;
	}
</style>
