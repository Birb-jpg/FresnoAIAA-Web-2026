---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/ui/Nav.astro';
import Sponsors from '../components/sections/Sponsors.astro';

import Footer from "../components/ui/Footer.astro";

---

<Layout title="Sponsors - AIAA // Fresno">
  <Nav />
  <!-- pt clears the fixed nav — this page has no Hero to sit under it -->
  <main id="main" class="flex flex-col w-full items-center px-6 sm:px-8 pt-32 pb-24">
    <article class="flex flex-col gap-24 sm:gap-36 lg:gap-48 w-full max-w-5xl">
      <Sponsors />
    </article>
  </main>
  <Footer/>
</Layout>