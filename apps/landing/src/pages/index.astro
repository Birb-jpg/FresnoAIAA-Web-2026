---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/ui/Nav.astro';
import Hero from '../components/sections/Hero.astro';
import Projects from '../components/sections/Projects.astro';
import Fleet from '../components/sections/Fleet.astro';
import About from '../components/sections/About.astro';
import Wiki from  '../components/sections/Wiki.astro'
import Contact from  '../components/sections/Contact.astro'
import Footer from "../components/ui/Footer.astro";

---

<Layout title="Home - AIAA // Fresno">
  <Nav />
  <Hero />
  <main class="flex flex-col w-full items-center">
    <article class="flex flex-col gap-48 max-w-5xl">
      <Projects />
      <Fleet />
      <About />
      <Wiki />
      <Contact />
    </article>
  </main>
  <Footer/>
</Layout>