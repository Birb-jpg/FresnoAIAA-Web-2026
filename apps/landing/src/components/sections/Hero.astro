---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import FAR from '../../assets/FAR0.webp';
---
<header class="w-dvw h-dvh px-12">

    <section class="flex flex-col max-w-1/3 h-full items-center">
        <section class="flex flex-col h-full items-start justify-center gap-6">
            <h2 class="text-lg uppercase font-normal tracking-widest">AIAA Student Chapter at Fresno State</h2>   
            <h1 class="text-7xl font-light tracking-normal uppercase">Building Rockets. <strong class="font-extrabold text-brand-light">Launching Dreams.</strong></h1>
            <p class="text-base max-w-lg text-gray-400">We are a student organization dedicated to promoting aerospace engineering and innovation.</p>
            <Button href="#about" variant="primary" size="lg">Learn More</Button>

        </section>
    </section>
    <!-- i love gradients!11!!1 -->
    <div class="absolute inset-0 w-full h-full pointer-events-none z-[-2] bg-radial-[at_70%_50%] from-transparent to-black/75 to-65%"></div>
    <div class="absolute inset-x-0 bottom-0 h-78 pointer-events-none z-[-1] bg-linear-to-b from-transparent to-background"></div>

    <!-- <div class="absolute inset-0 w-full h-full pointer-events-none z-[-1] bg-radial-[at_70%_50%] from-alpha to-black/75 to-65%"></div> -->
    <Image 
    src={FAR} 
    alt="Website header background showcasing our creative workspace" 
    class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none z-[-3]"
    quality="high"
    loading="eager"/>
    <!-- <div class="absolute inset-0 w-full h-full pointer-events-none z-[-1] bg-linear-60 from-black/75 to-alpha"></div> -->

</header>