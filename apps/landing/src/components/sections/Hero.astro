---
import { Image } from 'astro:assets';
import Button from '../ui/Button.astro';
import FAR from '../../assets/images/FAR0.webp';
---
<header class="w-full h-dvh px-6 sm:px-10 lg:px-12">

    <section data-fadein="left" data-fadein-delay="200" class="flex flex-col w-full max-w-2xl lg:max-w-1/3 h-full items-start lg:items-center">
        <section class="flex flex-col h-full items-start justify-center gap-6">
            <h2 class="text-sm sm:text-base lg:text-lg uppercase font-normal tracking-widest" data-fadein="up" data-fadein-delay="1000">AIAA Student Chapter at Fresno State</h2>
            <h1 class="text-4xl sm:text-6xl lg:text-7xl font-light tracking-normal uppercase text-balance">Building Rockets. <strong data-fadein="none" data-fadein-delay="700" class="font-extrabold text-brand-light">Launching Dreams.</strong></h1>
            <p class="text-sm sm:text-base max-w-lg text-gray-400"  data-fadein="down" data-fadein-delay="1500">We are a student organization dedicated to promoting aerospace engineering and innovation.</p>
            <span data-fadein="down" data-fadein-delay="1500">
                <Button href="#about" variant="primary" size="lg">Learn More</Button>
            </span>

        </section>
    </section>
    <!-- i love gradients!11!!1 -->
    <div class="absolute inset-0 w-full h-full pointer-events-none z-[-2] bg-linear-to-b lg:bg-radial-[at_50%_50%] from-transparent to-black/75 to-65%"></div>
    <div class="absolute inset-x-0 bottom-0 h-78 pointer-events-none z-[-1] bg-linear-to-b from-transparent to-background"></div>

    <!-- <div class="absolute inset-0 w-full h-full pointer-events-none z-[-1] bg-radial-[at_70%_50%] from-alpha to-black/75 to-65%"></div> -->
    <Image 
    data-fadein="none"
    data-fadein-delay="2000"
    src={FAR} 
    alt="Website header background showcasing our creative workspace" 
    class="absolute inset-0 w-full h-full object-cover pointer-events-none z-[-3] object-[25%_15%]"
    quality="high"
    loading="eager"/>
    <!-- <div class="absolute inset-0 w-full h-full pointer-events-none z-[-1] bg-linear-60 from-black/75 to-alpha"></div> -->

</header>