---
// OfficersSection.astro
import Section from '../ui/Section.astro';
import OfficerCard from '../ui/Officer.astro';
import Card from '../ui/Card.astro';

const officerImages = import.meta.glob('../../assets/*/*.{webp,png,jpg,jpeg}', { eager: true }) as Record<string, { default: string }>;

const officerInfo = {
  "President": {
    name: 'Cyan Roberts',
    bio: 'el presidente',
    imageFile: 'cyanr.png', // just the filename in the officers folder
  },
  "Vice President": {
    name: 'John Smith',
    bio: 'Woosh x2',
    imageFile: 'FAR0.webp',
  },
  "Treasurer": {
    name: 'Daniel Gooboian',
    bio: 'goob goob',
    imageFile: 'danielg.png',
  },
  "Secretary": {
    name: 'Isaac Lay',
    bio: 'computer nerd',
    imageFile: 'isaacl1.jpg',
  },
  "Launch Coordinator": {
    name: 'Ethan Jarocki',
    bio: 'L3 rocket nerd',
    imageFile: 'ethanj.jpg',
  },
  // "Event Coordinator": {
  //   name: 'John Smith',
  //   bio: 'Woosh x5',
  //   imageFile: 'FAR0.webp',
  // },
  // "K-12 Coordinator": {
  //   name: 'John Smith',
  //   bio: 'Woosh x6',
  //   imageFile: 'FAR0.webp',
  // },
  // "Media Coordinator": {
  //   name: 'John Smith',
  //   bio: 'Woosh x7',
  //   imageFile: 'FAR0.webp',
  // },
};

function getImage(filename: string) {
  const entry = Object.entries(officerImages).find(([path]) => path.endsWith(filename));
  if (!entry) throw new Error(`Officer image not found: ${filename}`);
  return entry[1].default;
}
---

<Section index="03" title="ABOUT US" subheading="What do we do again?" className="max-w-full" id="about">
  

    <section data-fadein="up" class="flex flex-col gap-6">
        <section class="grid grid-cols-1 md:grid-cols-6 gap-4 ">
            
            <Card className='md:col-span-4 md:row-span-2' ticks={false} type="Student Development" title="Workshops" image={getImage("group0.jpg")}>
                Students can work on their rocket kits and be advised by experienced peers.
            </Card>
            <Card className='md:col-span-2' ticks={false} type="Student Development" title="Tripoli Certifications" btnText="Learn More" href="https://www.tripoli.org/Certification" external={true} variant="secondary" image={getImage("TRABlack.jpg")}>
                Gain <abbr title="Tripoli Rocketry Association">TRA</abbr> certifications supported by our workshops.
            </Card>
            <Card className='md:col-span-2' ticks={false} type="Student Development" title="Internships">
                Many Alumni and current members are employed at <strong>Northrop Grumman</strong>, <strong>SpaceX</strong>, and other aerospace companies. We can help you get there too!
            </Card>
             <Card className='md:col-span-3' ticks={false} type="Volunteering" title="K-12 Outreach" btnText="Invite Our Team" href="mailto:aiaa.csufresno@gmail.com" variant="secondary" image={getImage("outreach0.jpg")}>
                2000+ students reached through our outreach events.
            </Card>
            <Card className='md:col-span-3' ticks={false} type="Competition" title="NASA USLI" image={getImage("sli26teamsign.jpeg")}>
                Our flagship competition where we design, build, and launch a high-powered rocket to meet specific requirements set by NASA.
            </Card>
            
        </section>

    </section>

    <section data-fadein="up" class="flex flex-col gap-4">
    <div class="h-px w-full bg-gradient-to-r from-transparent via-brand/40 to-transparent" />
      <h4 class="text-3xl font-normal text-foreground">Our Officers.</h4>
    <section data-fadein="up" class="grid grid-cols-1 md:grid-cols-3 gap-4">
    {Object.entries(officerInfo).map(([position, info]) => (
      <OfficerCard ticks={false} type={position} title={info.name} image={getImage(info.imageFile)}>
        {info.bio}
      </OfficerCard>
    ))}
  </section>
  </section>

</Section>