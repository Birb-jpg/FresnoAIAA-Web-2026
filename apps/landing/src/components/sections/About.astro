---
// OfficersSection.astro
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
const officerImages = import.meta.glob('../../assets/*/*.{webp,png,jpg,jpeg}', { eager: true }) as Record<string, { default: string }>;

const officerInfo = {
  "President": {
    name: 'Jane Doe',
    bio: 'Woosh x1',
    imageFile: 'FAR0.webp', // just the filename in the officers folder
  },
  "Vice President": {
    name: 'John Smith',
    bio: 'Woosh x2',
    imageFile: 'FAR0.webp',
  },
  "Treasurer": {
    name: 'John Smith',
    bio: 'Woosh x3',
    imageFile: 'FAR0.webp',
  },
  "Secretary": {
    name: 'John Smith',
    bio: 'Woosh x4',
    imageFile: 'FAR0.webp',
  },
  "Event Coordinator": {
    name: 'John Smith',
    bio: 'Woosh x5',
    imageFile: 'FAR0.webp',
  },
  "K-12 Coordinator": {
    name: 'John Smith',
    bio: 'Woosh x6',
    imageFile: 'FAR0.webp',
  },
  "Media Coordinator": {
    name: 'John Smith',
    bio: 'Woosh x7',
    imageFile: 'FAR0.webp',
  },
};

function getImage(filename: string) {
  const entry = Object.entries(officerImages).find(([path]) => path.endsWith(filename));
  if (!entry) throw new Error(`Officer image not found: ${filename}`);
  return entry[1].default;
}
---

<Section index="03" title="ABOUT US" subheading="What do we do again?" className="max-w-full" id="about">
  

    <section data-fadein="up" class="flex flex-col gap-6">
        <section class="grid grid-cols-1 md:grid-cols-6 gap-6 ">
            
            <Card className='md:col-span-4 md:row-span-2' ticks={false} type="Student Development" title="Workshops" image={getImage("group0.jpg")}>
                Students can work on their rocket kits and be advised by peers
            </Card>
            <Card className='md:col-span-2' ticks={false} type="Student Development" title="Tripoli Certifications" btnText="Learn More" href="#wikip1" variant="secondary" image={getImage("TRABlack.jpg")}>
                Gain Tripoli rocketry certifications supported by our workshops
            </Card>
            <Card className='md:col-span-2' ticks={false} type="Student Development" title="Internships">
                Many Alumni and current members...
            </Card>
             <Card className='md:col-span-3' ticks={false} type="Volunteering" title="K-12 Outreach" btnText="Invite Our Team" href="mailto:aiaafresno@gmail.com" variant="secondary" image={getImage("outreach0.jpg")}>
                2000+ people impacted, stats etc etc etc
            </Card>
            <Card className='md:col-span-3' ticks={false} type="Competition" title="NASA USLI" image={getImage("sli26teamsign.jpeg")}>
                Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.
            </Card>
            
        </section>

    </section>

    <section data-fadein="up" class="flex flex-col gap-6">
    <div class="h-px w-full bg-gradient-to-r from-transparent via-brand/40 to-transparent" />
      <h4 class="text-3xl font-normal text-foreground">Our Officers.</h4>
    <section data-fadein="up" class="grid grid-cols-1 md:grid-cols-4 gap-6">
    {Object.entries(officerInfo).map(([position, info]) => (
      <Card ticks={false} type={position} title={info.name} image={getImage(info.imageFile)}>
        {info.bio}
      </Card>
    ))}
  </section>
  </section>

</Section>