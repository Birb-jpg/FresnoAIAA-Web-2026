---
// Full-viewport hero: full-bleed launch media, gradient scrim, name + tagline + CTA.
---

<section class="relative h-screen">
	{/*
		PLACEHOLDER MEDIA — swap for a real launch video or photo.
		For video, replace the <img> with:

		<video
			class="absolute inset-0 h-full w-full object-cover"
			autoplay muted loop playsinline
			poster="/hero-poster.jpg"
		>
			<source src="/hero-launch.mp4" type="video/mp4" />
		</video>
	*/}
	<img
		src="/hero-placeholder.svg"
		alt=""
		aria-hidden="true"
		class="absolute inset-0 h-full w-full object-cover"
	/>

	{/* Scrim — text sits left, so darken left-to-right. If real media is too
	    bright, add: <div class="absolute inset-0 bg-black/40"></div> */}
	<div class="absolute inset-0 bg-gradient-to-r from-black/90 via-black/40 to-transparent"></div>
	<div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-background to-transparent"></div>

	<div class="absolute inset-0 z-10 flex flex-col justify-center px-8 md:px-20">
		<p class="mb-4 text-sm font-medium uppercase tracking-widest2 text-gray-400">
			{/* PLACEHOLDER university name */}
			AIAA Student Chapter — Placeholder University
		</p>
		<h1 class="max-w-3xl text-4xl font-extralight leading-tight tracking-tight text-white md:text-6xl">
			{/* PLACEHOLDER tagline */}
			Student-built rockets.<br />
			<span class="font-medium">Flight-proven ambition.</span>
		</h1>
		<p class="mt-6 max-w-xl text-base font-light leading-relaxed text-gray-400">
			{/* PLACEHOLDER body copy */}
			Placeholder: one or two sentences about who the chapter is, what it designs,
			builds, and flies, and the competitions it enters.
		</p>
		<div class="mt-10 flex flex-col gap-4 sm:flex-row sm:items-center">
			<a
				href="#join"
				class="inline-block rounded-sm bg-accent px-8 py-3 text-center text-sm font-semibold uppercase tracking-wide text-black transition-colors duration-300 hover:bg-accent-hover"
			>
				Join the Team
			</a>
			<a
				href="#projects"
				class="inline-block rounded-sm border border-border px-8 py-3 text-center text-sm font-medium uppercase tracking-wide text-gray-300 transition-colors duration-300 hover:border-accent hover:text-white"
			>
				See Our Work
			</a>
		</div>
	</div>
</section>
