---
import { Image } from 'astro:assets';
import Button from './Button.astro';
import FAR from '../assets/FAR0.webp';
---
<header class="w-dvw h-dvh px-12">

    <section class="flex flex-col max-w-1/3 h-full items-center">
        <section class="flex flex-col h-full items-start justify-center">
            <section class="flex flex-col gap-16">
            <h1 class="text-6xl font-semibold tracking-tight uppercase">Building Rockets. <br> Launching Dreams.</h1>
            <h2 class="text-4xl uppercase font-light">AIAA // Fresno</h2>   
        </section>
        <section class="flex flex-col gap-4">
            <p class="text-base max-w-md">We are a student organization dedicated to promoting aerospace engineering and innovation.</p>
            <section class="flex flex-row gap-8">
                <!-- <a href="#about" class="px-6 py-2 border text-base uppercase font-medium bg-(--color-brand) text-white ">About Us</a>
                <a href="#fleet" class="px-6 py-2 border text-base uppercase font-medium">Our Fleet</a> -->
                <Button href="#about" variant="primary" size="lg">Learn More</Button>
            </section>
        </section>
        </section>
    </section>
    <div class="absolute inset-0 w-full h-full pointer-events-none z-[-1] bg-radial-[at_70%_50%] from-alpha to-black/75 to-75%"></div>
    <Image 
    src={FAR} 
    alt="Website header background showcasing our creative workspace" 
    class="absolute inset-0 w-full h-full object-cover object-center pointer-events-none z-[-2]"
    quality="high"
    loading="eager"/>
    <!-- <div class="absolute inset-0 w-full h-full pointer-events-none z-[-1] bg-linear-60 from-black/75 to-alpha"></div> -->

</header>