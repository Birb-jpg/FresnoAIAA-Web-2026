---
import { twMerge } from "tailwind-merge";
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import { Image } from 'astro:assets';
import type { Props as ButtonProps } from './Button.astro';
interface Props extends Pick<ButtonProps, 'href' | 'variant'> {
  type: string;
  title: string;
  btnText?: string;
  image?: ImageMetadata;
  alt?: string;
  className?: string;
  external?: boolean;
  ticks?: boolean;
}

const { type, title, btnText, href, variant, image, alt = "noalt", className = "", ticks = true,external=false } = Astro.props;
const base = "group relative flex flex-col border border-brand/20 gap-2 hover:border-brand transition-all duration-300 rounded-md overflow-hidden";
const classes = twMerge(base, className)
---
<section class={classes}>
  
  {ticks && (
    <>
      <span aria-hidden="true" class="pointer-events-none absolute top-1.5 left-1.5 w-2.5 h-2.5 border-t border-l border-brand/40 group-hover:border-brand/80 transition-colors duration-300"></span>
      <span aria-hidden="true" class="pointer-events-none absolute top-1.5 right-1.5 w-2.5 h-2.5 border-t border-r border-brand/40 group-hover:border-brand/80 transition-colors duration-300"></span>
      <span aria-hidden="true" class="pointer-events-none absolute bottom-1.5 left-1.5 w-2.5 h-2.5 border-b border-l border-brand/40 group-hover:border-brand/80 transition-colors duration-300"></span>
      <span aria-hidden="true" class="pointer-events-none absolute bottom-1.5 right-1.5 w-2.5 h-2.5 border-b border-r border-brand/40 group-hover:border-brand/80 transition-colors duration-300"></span>
    </>
  )}
  {image && <Image class="w-full h-auto aspect-square object-cover" src={image} alt={alt} />}
  <section class="flex flex-col p-6 gap-1 flex-1">
    <h2 class="text-xs uppercase text-brand-light font-normal tracking-tight">{type}</h2>
    <h3 class="text-lg text-foreground font-bold">{title}</h3>
    <p class="text-sm text-foreground/50"><slot /></p>
    <section class="w-full h-auto flex flex-col mt-auto">
      {btnText && href && <Button href={href} variant={variant} external={external}>{btnText}</Button>}
    </section>
  </section>
</section>