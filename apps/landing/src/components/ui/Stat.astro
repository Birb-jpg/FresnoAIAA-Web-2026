---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<section class="flex flex-col">
  <h4 class="text-xs uppercase text-foreground/50 font-normal tracking-widest font-mono">{label}</h4>
  <p class="text-xs text-brand-light tracking-widest font-normal font-mono">{value}</p>
</section>