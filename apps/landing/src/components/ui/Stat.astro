---
interface Props {
  label: string;
  value: string;
}

const { label, value } = Astro.props;
---

<section class="flex flex-col items-center text-center min-w-0">
  <p class="text-xs uppercase text-foreground/50 font-normal tracking-widest font-mono">{label}</p>
  <p class="text-xs text-brand-light tracking-widest font-normal font-mono break-words">{value}</p>
</section>