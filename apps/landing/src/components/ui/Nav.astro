---
import Button from '../ui/Button.astro';

const links = [
    { href: '/#projects', label: 'Projects' },
    { href: '/#fleet', label: 'Fleet' },
    { href: '/#about', label: 'About Us' },
    { href: '/#wiki', label: 'Wiki' },
    { href: '/#contact', label: 'Contact' },
];
---

<nav
    data-scrolled="false"
    class="w-full fixed top-0 left-0 z-20 transition-colors duration-300 border-b border-transparent
           data-[scrolled=true]:bg-background/85 data-[scrolled=true]:backdrop-blur-md data-[scrolled=true]:border-brand/15"
>
    <div data-fadein="up" data-fadein-delay="200" class="w-full flex flex-row justify-between md:justify-around items-center px-6 py-4">
        <a href="/" class="text-md font-normal uppercase text-center tracking-widest text-white hover:text-brand-light">AIAA <span class="text-brand-light font-bold">//</span> Fresno State</a>

        <!-- Desktop links -->
        <ul class="hidden md:flex flex-row items-center">
            {links.map((l) => (
                <li><Button href={l.href} variant="ghost" size="md">{l.label}</Button></li>
            ))}
            <li><Button href="/sponsors" variant="outline" className="border-brand-light" size="md">Sponsors</Button></li>
        </ul>

        <!-- Mobile toggle -->
        <button
            id="nav-toggle"
            type="button"
            aria-label="Toggle navigation"
            aria-expanded="false"
            aria-controls="mobile-nav"
            class="md:hidden inline-flex flex-col justify-center items-center gap-1.5 w-10 h-10 rounded-md border border-brand/20 text-foreground"
        >
            <span class="block w-5 h-0.5 bg-current transition-all duration-300"></span>
            <span class="block w-5 h-0.5 bg-current transition-all duration-300"></span>
            <span class="block w-5 h-0.5 bg-current transition-all duration-300"></span>
        </button>
    </div>

    <!-- Mobile panel -->
    <div
        id="mobile-nav"
        data-open="false"
        class="md:hidden flex-col gap-2 px-6 pt-2 pb-6 bg-background/95 backdrop-blur-md border-b border-brand/15"
    >
        <ul class="flex flex-col gap-1">
            {links.map((l) => (
                <li><Button href={l.href} variant="ghost" size="md" className="w-full justify-start py-3">{l.label}</Button></li>
            ))}
            <li class="mt-2"><Button href="/sponsors" variant="outline" className="w-full justify-center border-brand-light py-3" size="md">Sponsors</Button></li>
        </ul>
    </div>
</nav>

<style>
    #mobile-nav { display: none; }
    #mobile-nav[data-open="true"] { display: flex; }
    @media (min-width: 768px) {
        #mobile-nav { display: none !important; }
    }
    /* Hamburger -> X when open */
    #nav-toggle[aria-expanded="true"] span:nth-child(1) { transform: translateY(0.5rem) rotate(45deg); }
    #nav-toggle[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
    #nav-toggle[aria-expanded="true"] span:nth-child(3) { transform: translateY(-0.5rem) rotate(-45deg); }
</style>

<script>
    const nav = document.querySelector('nav[data-scrolled]');
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('mobile-nav');

    const isOpen = () => menu?.getAttribute('data-open') === 'true';

    const paintBar = () => {
        // solid bar whenever content sits under it, or while the panel is open
        nav?.setAttribute('data-scrolled', String(window.scrollY > 24 || isOpen()));
    };

    const setOpen = (open: boolean) => {
        menu?.setAttribute('data-open', String(open));
        toggle?.setAttribute('aria-expanded', String(open));
        paintBar();
    };

    toggle?.addEventListener('click', () => setOpen(!isOpen()));

    menu?.querySelectorAll('a').forEach((a) =>
        a.addEventListener('click', () => setOpen(false))
    );

    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && isOpen()) {
            setOpen(false);
            toggle?.focus();
        }
    });

    // panel is display:none past md — don't leave it "open" behind the desktop links
    window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
        if (e.matches && isOpen()) setOpen(false);
    });

    window.addEventListener('scroll', paintBar, { passive: true });
    paintBar();
</script>
