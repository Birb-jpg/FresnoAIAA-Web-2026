---
import { twMerge } from "tailwind-merge";
interface Props {
    id?: string;
    index?: string;
    title: string;
    subheading?: string;
    className?: string;
}
 
const { id = "", index = "", title, subheading, className = ""} = Astro.props;
const base = "flex flex-col gap-8 w-full";

const classes = twMerge(base, className);

---
<section class={classes} id={id}>
    <section>
        <h3 class="text-sm uppercase tracking-widest text-foreground/50 font-medium">
            {index}
            <em class="text-brand-light"> / </em>
            {title}
        </h3>
        {subheading && (
            <h4 class="text-3xl font-normal text-foreground">{subheading}</h4>
        )}
    </section>
    <slot />

</section>