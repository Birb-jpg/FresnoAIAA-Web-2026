---
import { twMerge } from "tailwind-merge";
interface Props {
  title: string;
  subheading?: string;
  className?: string;
}
 
const { title, subheading, className = ""} = Astro.props;
const base = "flex flex-col gap-8 w-full";

const classes = twMerge(base, className);

---
<section class={classes}>
    <section>
        <h3 class="text-sm uppercase font-light tracking-widest text-gray-500">
            {title}
        </h3>
        {subheading && (
            <h4 class="text-3xl font-normal text-foreground">{subheading}</h4>
        )}
    </section>
    <slot />

</section>