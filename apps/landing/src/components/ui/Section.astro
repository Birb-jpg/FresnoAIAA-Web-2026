---
import { twMerge } from "tailwind-merge";
interface Props {
    id?: string;
    index?: string;
    title: string;
    subheading?: string;
    className?: string;
}
 
const { id = "", index = "", title, subheading, className = ""} = Astro.props;
const base = "flex flex-col gap-8 w-full scroll-mt-24";

const classes = twMerge(base, className);

---
<section class={classes} id={id}>
    <section>
        <h3 class="text-xs uppercase tracking-tight font-mono text-foreground/50 font-thin">
            {index}
            <span class="text-brand-light font-bold"> / </span>
            {title}
        </h3>
        {subheading && (
            <h4 class="text-3xl font-sans font-normal text-foreground tracking-tight">{subheading}</h4>
        )}
    </section>
    <slot />

</section>