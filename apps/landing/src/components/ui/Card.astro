---
import { twMerge } from "tailwind-merge";
import type { ImageMetadata } from 'astro';
import Button from '../ui/Button.astro';
import { Image } from 'astro:assets';
import type { Props as ButtonProps } from './Button.astro';
interface Props extends Pick<ButtonProps, 'href' | 'variant'> {
  type: string;
  title: string;
  btnText?: string;
  image?: ImageMetadata;
  alt?: string;
  className?: string;
}

const { type, title, btnText, href, variant, image, alt = "noalt",className = "" } = Astro.props;
const base = "flex flex-col border border-brand/20 gap-2 hover:border-brand transition-all duration-300";
const classes = twMerge(base,className)
---
 
<section class={classes}>
  {image && <Image src={image} alt={alt} />}
  <section class="flex flex-col p-6 gap-1 flex-1">
    <h2 class="text-sm uppercase text-brand-light tracking-widest font-normal">{type}</h2>
    <h3 class="text-lg uppercase text-foreground font-bold tracking-widest">{title}</h3>
    <p class="text-base text-foreground/50"><slot /></p>
    <section class="w-full h-auto flex flex-col mt-auto">
      {btnText && href && <Button href={href} variant={variant}>{btnText}</Button>}
    </section>
  </section>
</section>
